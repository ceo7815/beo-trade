# Copy to .env on the XCloud server. Do not commit .env.
# Empty provider keys are valid before payment. The worker stays up and does not buy.
# APP_ENV stays local. The value production refuses the SQLite runtime database.

# APPLICATION
# APP_ENV — required — local — SQLite runtime. production is rejected.
APP_ENV=local
# PAPER_ONLY — required — true — startup fails otherwise.
PAPER_ONLY=true
# TRADING_MODE — required — PAPER — the only accepted mode.
TRADING_MODE=PAPER
# AUTO_CREATE_TABLES — required — true — creates missing tables, never drops data.
AUTO_CREATE_TABLES=true
# AUTH_REQUIRED — optional — false — local single-user desk. Do not publish port 8000.
AUTH_REQUIRED=false
# DISPLAY_TIMEZONE — optional — Asia/Dubai — display only.
DISPLAY_TIMEZONE=Asia/Dubai
# EXCHANGE_TIMEZONE — optional — America/New_York — market session logic.
EXCHANGE_TIMEZONE=America/New_York
# CORS_ORIGINS — optional — http://localhost:3000 — browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
# WEB_PORT — optional — host port for the web container. Used by Compose, not by the app process.
WEB_PORT=3000
# LOG_LEVEL — optional — INFO
LOG_LEVEL=INFO

# DATABASE
# DATABASE_URL — optional — empty uses SQLite on the beo_data volume.
# Do not point this at a database you have not chosen to operate. Leaving it empty is the supported deployment.
DATABASE_URL=
# SUPABASE_JWT_SECRET — optional here — required only if APP_ENV=production, which this package does not use.
SUPABASE_JWT_SECRET=
# SUPABASE_JWT_AUDIENCE — optional — authenticated
SUPABASE_JWT_AUDIENCE=authenticated

# ALPACA
# Paper host only. A live host fails validation and startup.
# ALPACA_API_KEY — optional until broker checks — paper key from Alpaca.
ALPACA_API_KEY=
# ALPACA_API_SECRET — optional until broker checks — paper secret. Never a live secret.
ALPACA_API_SECRET=
# ALPACA_BASE_URL — optional — empty means the built-in paper host.
ALPACA_BASE_URL=
# Active options account = paper_20k_ils (beo 20K ILS). Point ALPACA_API_KEY /
# ALPACA_API_SECRET / ALPACA_BASE_URL at that paper account only.
# The old beo 10K ILS paper account (PA3LU0NE5) was deleted. The period stays
# for stored history. A failed view credential is hidden as unavailable and
# does not affect options orders.
#
# Optional read-only keys for the legacy 100K paper view:
# ALPACA_100K_API_KEY=
# ALPACA_100K_API_SECRET=
# When absent, or when those keys fail, the 100K period falls back to DB history.
# 100K keys are never used to submit orders.
# Never paste keys in chat.


# THETADATA
# Do not assume 127.0.0.1 inside the container.
# Set the URL of the host that actually runs Theta Terminal, for example http://10.0.0.8:25503
# THETADATA_BASE_URL — optional — empty uses http://theta:25503 on the Docker network.
# Do not use 127.0.0.1. That address is the container itself, not another computer.
THETADATA_BASE_URL=
# THETA_TERMINAL_HOST — optional — used only when THETADATA_BASE_URL is empty.
THETA_TERMINAL_HOST=
# THETA_TERMINAL_PORT — optional — 25503 — used with THETA_TERMINAL_HOST.
THETA_TERMINAL_PORT=25503
# THETADATA_API_KEY — optional — terminal credential when the terminal requires one.
THETADATA_API_KEY=
# THETADATA_CLIENT_KEY — optional — ThetaData client id sent as TD-TERMINAL-KEY on the identity probe.
# Leave this empty in git. Set the real value only in the XCloud environment file. Never paste it here.
THETADATA_CLIENT_KEY=
# MARKET_DATA_PROVIDER — optional — unconfigured — set thetadata after the terminal answers.
MARKET_DATA_PROVIDER=unconfigured
# OPTIONS_DATA_PROVIDER — optional — unconfigured
OPTIONS_DATA_PROVIDER=unconfigured

# BENZINGA
# BENZINGA_API_KEY — optional — empty means news confirmation cannot pass.
BENZINGA_API_KEY=
# NEWS_PROVIDER — optional — unconfigured — benzinga after a key is present.
NEWS_PROVIDER=unconfigured

# ACCESS — set all five in the XCloud environment file, then Deploy Now.
# An empty API_ADMIN_KEY does not leave the API open. Data and mutating routes answer 503 until it is set.
# With both keys set, a request without a key answers 401. /health and /ready stay public.
# Do not put real values in this file.
# API_ADMIN_KEY — long random string. The dashboard adds it only for a signed-in session.
API_ADMIN_KEY=
# API_READ_KEY — long random string. Read-only: GET of reports, positions, decisions. For Grok Bot.
API_READ_KEY=
# DASHBOARD_USER — login name.
DASHBOARD_USER=
# DASHBOARD_PASSWORD — login password. Set it in the XCloud environment file only, never in code.
DASHBOARD_PASSWORD=
# SESSION_SECRET — long random string that signs the 30-day login cookie.
SESSION_SECRET=

# OPENAI
# OPENAI_API_KEY — optional — empty blocks AI buys. The key stays on the server.
OPENAI_API_KEY=
# OPENAI_MODEL — required when set — gpt-6.1-sol
OPENAI_MODEL=gpt-6.1-sol
# OPENAI_BASE_URL — optional — https://api.openai.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1
# Prices are USD per 1M tokens.
OPENAI_PRICE_INPUT_PER_MILLION=2
OPENAI_PRICE_CACHED_INPUT_PER_MILLION=0.10
OPENAI_PRICE_OUTPUT_PER_MILLION=10

# FRED
# FRED_API_KEY — optional — empty leaves the macro feed unused.
FRED_API_KEY=

# SEC
# SEC_USER_AGENT — required for SEC requests — contact string, not a password.
SEC_USER_AGENT=Beo-Trade research platform (Beo Systems) research@beosystems.com

# REDIS
# REDIS_URL — optional — empty disables event publish. Trading does not require Redis.
REDIS_URL=

# TRADING
# Risk and exit numbers are NOT environment variables.
# They are baked from backend/app/config/trading.toml.
# TRADING_CONFIG_PATH must stay empty. A path override fails startup.
# PAPER_ACCOUNT_BALANCE — optional — 1000 — opening cash for the internal paper user only.
PAPER_ACCOUNT_BALANCE=1000

# AI
# Monthly and daily ceilings in USD. A missing price blocks AI calls.
AI_SOFT_BUDGET=150
AI_WARNING_BUDGET=150
AI_CRITICAL_BUDGET=180
AI_HARD_LIMIT=200
MAX_AI_COST_PER_DAY=20

# OBSERVABILITY
# Backend URL inside the Docker network. The browser calls /backend on the web container.
BACKEND_URL=http://api:8000

# SPY INTRADAY (separate paper account, separate process, off until enabled)
# Does not use ALPACA_API_KEY. A live host (api.alpaca.markets) refuses to start.
# SPY_ENGINE_ENABLED — optional — false — set true only after the paper keys below are set.
SPY_ENGINE_ENABLED=false
# SPY_ALPACA_KEY_ID — paper key for the new $25,000 intraday account. Not the options key.
SPY_ALPACA_KEY_ID=
# SPY_ALPACA_SECRET_KEY — paper secret for that same account. Never log it.
SPY_ALPACA_SECRET_KEY=
# SPY_ALPACA_ACCOUNT — pin of the new $25,000 paper account. Leave empty until the number is known.
# The retired SPY Intraday 20K account is not a default and must not be pasted here.
SPY_ALPACA_ACCOUNT=
# SPY_ALPACA_BASE_URL — must stay the paper host.
SPY_ALPACA_BASE_URL=https://paper-api.alpaca.markets
# SPY_DATA_URL — minute bars only. This host cannot place orders.
SPY_DATA_URL=https://data.alpaca.markets
# SPY_PDT_GUARD — true — under $25,000, skip an entry when no day trade is left.
SPY_PDT_GUARD=true
# SPY_ALLOW_SHORT — false — live book is long-only. Short math stays in the code.
SPY_ALLOW_SHORT=false
# SPY_TRADE_SYMBOLS — comma list. Each name has its own noise zone. Order is the priority when slots are scarce.
SPY_TRADE_SYMBOLS=SPY,QQQ,IWM
# SPY_MAX_POSITIONS — 3 — each name is sized on equity / this number. Gross exposure stays within 1x.
SPY_MAX_POSITIONS=3
# SPY_MAX_ENTRIES_DAY — 6 — book cap. Each symbol also stops after 2 entries that day.
SPY_MAX_ENTRIES_DAY=6
# SPY_SHADOW_SYMBOLS — empty — names here are hypothetical only and never ordered. Traded names are ignored.
SPY_SHADOW_SYMBOLS=
# Kill switch file on the data volume: touch data/spy_kill.flag (or SPY_KILL_SWITCH=true).
# SPY_KILL_SWITCH=false
